#: ui/main.qml
msgctxt "@info risk of a service"
msgid "May affect Android"
msgstr "可能影响 Android"

#: ui/main.qml
msgctxt "@info risk of a service"
msgid "Unknown impact"
msgstr "影响未知"

#: ui/main.qml
msgctxt "@info risk of a service"
msgid "No use on this device"
msgstr "在本机没有作用"

#: ui/main.qml
