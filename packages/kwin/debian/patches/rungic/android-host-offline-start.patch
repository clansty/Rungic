-        return false;
+        if (!allowOfflineStart() || m_display) {
+            return false;
+        }
+        // The renderer belongs to Linux. Keep one inhibited phone output, so
+        // Plasma can create its panels before any display client connects.
+        m_drmDevice = DrmDevice::open(renderDevicePath());
+        if (m_drmDevice) {
+            setUpRenderDevice(m_drmDevice.get());
+        }
+        createOutputs();
     }
 
