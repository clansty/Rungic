+void AndroidBackend::hostLost()
+{
+    if (m_reconnecting) {
+        return;
+    }
+    qCWarning(KWIN_WAYLAND_BACKEND) << "Android host connection lost; keeping the session and waiting for the host";
+    m_reconnecting = true;
+    m_initialized = false;
+    // Everything bound on the host belongs to the dead connection (its proxies are left to it).
+    m_textInput.reset();
+    m_textInputManager = nullptr;
+    m_idleInhibitor = nullptr;
+    m_idleInhibitManager = nullptr;
+    m_queue = nullptr;
+    // A cast display was a host output: it goes with the host. The phone's output stays
+    // (disconnectHost) and is bound to the next host window (reconnectHost).
+    for (Wayland::WaylandOutput *output : std::as_const(m_castOutputs)) {
+        qCInfo(KWIN_WAYLAND_BACKEND) << "Cast output removed with the host" << output->name();
+        removeOutput(output);
+    }
+    m_castOutputs.clear();
+    m_hostOutputs.clear();
+    disconnectHost();
+    m_reconnectTimer.start();
+}
+
+void AndroidBackend::reconnectHost()
+{
+    // Only connect once the host's socket answers: a connection attempt must not block.
+    if (wl_display *probe = wl_display_connect(options().socketName.toUtf8().constData())) {
+        wl_display_disconnect(probe);
+    } else {
+        return;
+    }
+    if (!connectHost()) {
+        qCWarning(KWIN_WAYLAND_BACKEND) << "Android host answered but the connection failed; retrying";
+        return;
+    }
+    m_reconnectTimer.stop();
+    bindHostGlobals();
+    if (m_textInputManager) {
+        m_textInput = std::make_unique<HostTextInput>(m_textInputManager, *display()->seat());
+    }
+    m_initialized = true;
+    m_reconnecting = false;
+    for (HostOutput *hostOutput : std::as_const(m_hostOutputs)) {
+        handleHostOutput(hostOutput);
+    }
+    if (InputRedirection *redirect = input()) {
+        setIdleInhibited(!redirect->idleInhibitors().isEmpty());
+    }
+    qCInfo(KWIN_WAYLAND_BACKEND) << "Reconnected to the Android host";
+}
