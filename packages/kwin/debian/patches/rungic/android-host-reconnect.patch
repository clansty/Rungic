+void WaylandBackend::disconnectHost()
+{
+    // The host is gone (src/backends/android). Its outputs stay for the workspace and its clients
+    // (a workspace without outputs ends plasmashell: its panels get a zero size), but stop
+    // rendering and let go of the host window (WaylandOutput::unbindHost) until connectHost binds
+    // them to the next host. The input devices and every buffer imported on the connection go. The
+    // dead display itself stays until connectHost replaces it.
+    for (WaylandOutput *output : std::as_const(m_outputs)) {
+        output->unbindHost();
+    }
+    m_seat.reset();
+    m_buffers.clear();
+}
 
+bool WaylandBackend::rebindOutputs()
+{
+    for (WaylandOutput *output : std::as_const(m_outputs)) {
+        output->bindHost();
+    }
+    // Wait until the host configured the windows again, as for new ones (createOutput).
+    while (std::ranges::any_of(m_outputs, [](WaylandOutput *output) {
+        return !output->isReady();
+    })) {
+        if (wl_display_roundtrip(m_display->nativeDisplay()) < 0) {
+            qCWarning(KWIN_WAYLAND_BACKEND) << "Host connection lost before the outputs were configured";
+            for (WaylandOutput *output : std::as_const(m_outputs)) {
+                output->unbindHost();
+            }
+            return false;
+        }
+    }
+    for (WaylandOutput *output : std::as_const(m_outputs)) {
+        output->resumeRendering();
+    }
     return true;
 }
 
