+void WaylandOutput::unbindHost()
+{
+    if (!m_hostBound) {
+        return;
+    }
+    m_hostBound = false;
+    // Nothing is drawn until the host is back: frames still waiting for the lost host are dropped,
+    // and buffers leased from it go (the next frames are drawn in full into new ones).
+    m_renderLoop->inhibit();
+    m_configureThrottleTimer.stop();
+    m_frames.clear();
+    for (const auto &layer : m_layers) {
+        layer->releaseBuffers();
+        if (layer->type() != OutputLayerType::CursorOnly) {
+            static_cast<WaylandLayer *>(layer.get())->unbindHost();
+        }
+    }
+    destroyHostWindow();
+}
+
+void WaylandOutput::bindHost()
+{
+    if (m_hostBound) {
+        return;
+    }
+    createHostWindow();
+    // The layers' subsurfaces in their order above the window (WaylandEglBackend::createOutputLayers).
+    KWayland::Client::Surface *below = m_surface.get();
+    for (const auto &layer : m_layers) {
+        if (layer->type() == OutputLayerType::CursorOnly) {
+            continue;
+        }
+        auto waylandLayer = static_cast<WaylandLayer *>(layer.get());
+        waylandLayer->bindHost();
+        waylandLayer->subSurface()->placeAbove(below);
+        below = waylandLayer->surface();
+    }
+    m_hostBound = true;
+    m_mapped = false;
+    m_ready = false;
+    if (m_fullscreen && m_fullscreenOn) {
+        xdg_toplevel_set_fullscreen(*m_xdgShellSurface, m_fullscreenOn);
+    } else {
+        m_xdgShellSurface->setFullscreen(m_fullscreen);
+    }
+    m_surface->commit(KWayland::Client::Surface::CommitFlag::None);
+}
+
+void WaylandOutput::resumeRendering()
+{
+    m_renderLoop->uninhibit();
+    for (const auto &layer : m_layers) {
+        layer->addDeviceRepaint(Region::infinite());
+    }
+}
+
+bool WaylandOutput::isHostBound() const
+{
+    return m_hostBound;
+}
