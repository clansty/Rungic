+void WaylandBackend::disconnectHost()
+{
+    // The host is gone (src/backends/android): its outputs go (the workspace keeps the windows on
+    // a placeholder), and so do the input devices and every buffer imported on the connection.
+    // The dead display itself stays until connectHost replaces it.
+    const QList<WaylandOutput *> outputs = m_outputs;
+    for (WaylandOutput *output : outputs) {
+        removeOutput(output);
+    }
+    m_seat.reset();
+    m_buffers.clear();
+}
